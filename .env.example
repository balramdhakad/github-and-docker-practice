# ============================================================
# hello-app: env template  (yeh file git mein jaa sakti hai)
# Copy karke apni .env banao:
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
# phir REDIS_PASSWORD badlo.
# ============================================================

# ---- Secret ----
# Redis password. docker compose + local run dono isse use karte hain.
# Random banane ke liye: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
REDIS_PASSWORD=change-me

# ---- App settings (local "npm run dev" ke liye) ----
PORT=3000
APP_VERSION=v1
REDIS_URL=redis://localhost:6379
NODE_ENV=development
